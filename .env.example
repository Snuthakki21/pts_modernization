# Set these in your local shell; this template is not auto-loaded.
WB_ASSISTANT_MODE=claude_files
WB_ZOWE_PROFILE=YOUR_EXISTING_READ_ONLY_PROFILE
WB_ZOWE_ZOSMF_PROFILE=YOUR_PAIRED_ZOSMF_PROFILE
WB_DB2_MCP_URL=http://127.0.0.1:8766/mcp
WB_DB2_MCP_TOKEN=SET_A_PRIVATE_RANDOM_TOKEN
# Db2 connection fields live in tools/dq3g_mcp/.env; see its .env.example.
# Claude Code analyzes, develops, tests and reviews approved local files; no MCP servers.
# GitHub Copilot uses already approved MCP connections only to retrieve files/metadata.
# This local-file workflow requires no model endpoint/token.
