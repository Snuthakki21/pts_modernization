# Set these in your local shell; this file is a template and is not auto-loaded.
WB_ASSISTANT_MODE=copilot_chat
WB_ZOWE_PROFILE=YOUR_EXISTING_READ_ONLY_PROFILE
WB_ZOWE_ZOSMF_PROFILE=YOUR_PAIRED_ZOSMF_PROFILE
WB_DB2_MCP_URL=http://127.0.0.1:8766/mcp
WB_DB2_MCP_TOKEN=SET_A_PRIVATE_RANDOM_TOKEN
WB_DB2_CONFIG=ABSOLUTE_WORKSPACE_PATH/.migration/db2-config.json
WB_DB2_USER=YOUR_PRIVATE_READ_ONLY_USERNAME
WB_DB2_PASSWORD=YOUR_PRIVATE_PASSWORD
# Copilot Chat requires no model URL/token. Legacy explicit provider only:
# WB_LLM_URL=https://YOUR_APPROVED_PROVIDER/v1/chat/completions
# WB_LLM_MODEL=YOUR_APPROVED_MODEL
# WB_LLM_TOKEN=YOUR_PRIVATE_TOKEN
# WB_ALLOW_SOURCE_EGRESS=true
# Legacy externally secured driver connection (TLS/cert responsibility external):
# WB_DB2_ODBC_CONNECTION=YOUR_IBM_ODBC_CONNECTION_STRING
