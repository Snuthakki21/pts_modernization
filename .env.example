# Copy this template to WORKSPACE/.env. Fill it ONLY in an approved local editor.
# Never commit .env, paste it into Claude/chat, or share credential screenshots.
# Values are literal: quote values containing spaces, # or $. No shell expansion.
# Obtain the actual hosts, ports, DDF location and TSO values from your administrator.

# Db2: DATABASE must equal LOCATION_NAME for this z/OS adapter.
DB2_LOCATION_NAME=YOUR_DDF_LOCATION
DB2_DATABASE=YOUR_DDF_LOCATION
DB2_HOSTNAME=db2.example.invalid
DB2_PORT=YOUR_DB2_PORT
DB2_USERNAME=
DB2_PASSWORD=
DB2_SSL_CONNECTION=true
DB2_SSL_SERVER_CERTIFICATE=certificates/DB2-CA.cert

# Zowe: select dev or prod. The selected host/port pair is required.
# Leave an unused environment's host AND port empty; do not guess a prod endpoint.
ZOWE_ENVIRONMENT=dev
ZOWE_DEV_HOST=zosmf.example.invalid
ZOWE_DEV_PORT=YOUR_ZOSMF_PORT
ZOWE_PROD_HOST=
ZOWE_PROD_PORT=
ZOWE_TSO_ACCOUNT=YOUR_TSO_ACCOUNT
ZOWE_TSO_CODE_PAGE=YOUR_TSO_CODE_PAGE
ZOWE_TSO_LOGON_PROCEDURE=YOUR_TSO_LOGON_PROCEDURE
ZOWE_CA_CERTIFICATE=certificates/ZOWE-CA.pem

# Optional local CLI credentials. Prefer the Zowe secure-store prompt for Explorer.
# .env alone does not sign Zowe Explorer in; run the documented secure-store step.
ZOWE_USERNAME=
ZOWE_PASSWORD=

# Place the actual approved Db2 CA at certificates/DB2-CA.cert (PEM or DER).
# Place the actual approved z/OSMF CA chain at certificates/ZOWE-CA.pem (PEM).
# Do not put certificates in .migration or turn certificate validation off.
# Local stdio Db2 MCP needs no transport token, URL, HTTP port or WB_* settings.
