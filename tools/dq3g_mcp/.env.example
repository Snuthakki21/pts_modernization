# Copy to .env; credentials and certificates remain private and ignored.
DB2_LOCATION_NAME=YOUR_DDF_LOCATION
DB2_HOSTNAME=db2.example.invalid
DB2_PORT=5116
DB2_DATABASE=YOUR_DATABASE
# DB2_USERNAME=YOUR_READ_ONLY_USERNAME
DB2_PASSWORD=
DB2_SSL_CONNECTION=true
DB2_SSL_CERT_LOCATION=certs/approved-root.cer
DB2_QUERY_ROW_LIMIT=500000
