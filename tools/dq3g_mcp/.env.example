# Copy locally to WORKSPACE/.env; never commit or paste its contents into Claude/chat.
# DB2_DATABASE equals DB2_LOCATION_NAME for this z/OS adapter.
DB2_LOCATION_NAME=YOUR_DDF_LOCATION
DB2_DATABASE=YOUR_DDF_LOCATION
DB2_HOSTNAME=db2.example.invalid
DB2_PORT=5116
DB2_USERNAME=
DB2_PASSWORD=
DB2_SSL_CONNECTION=true
DB2_SSL_SERVER_CERTIFICATE=certificates/DB2-CA.cert
